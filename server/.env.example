# Wayfinder AI — Server Configuration & Private Secrets
# IMPORTANT: Keep this file private. Never commit .env with real production keys.

# 1. Server Port
PORT=3000
NODE_ENV=production

# 2. Private AI Gateway Keys (Stored on server ONLY, never exposed to Chrome Extension)
OPENAI_API_KEY=sk-proj-your-private-openai-key-here
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-your-claude-key-here

# 3. Stripe Billing Webhook Secret (From Stripe Dashboard -> Webhooks -> Add Endpoint -> Signing Secret)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# 4. Subscription Product IDs (Optional, from Stripe Dashboard)
# STRIPE_PRO_PRICE_ID=price_123456789
